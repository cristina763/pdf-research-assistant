# Loaded by scripts/run_backend.py and scripts/download_models.py.
# Existing process environment variables take precedence. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
ENABLE_GENERATION=false
CONTEXT_MODE=baseline
MAX_UPLOAD_MB=30
RAG_DATA_DIR=data
DOCLING_ARTIFACTS_PATH=models
GENERATION_BUDGET_USD=1
GENERATION_MAX_CALLS=40
# OPENAI_MODEL is optional; blank/unset uses the validated default above.
# Restart the backend after changing .env.
# Changing a model also requires reviewing its token interface and fee estimates.
